# ---------------------------------------------------------------------------
# Down South Pressure Washing — environment
# Copy to `.env.local` and fill in only what you need.
# The quote form works with NOTHING set here (it uses FormSubmit — see README).
# ---------------------------------------------------------------------------

# Absolute site origin. Required for correct canonical URLs, Open Graph tags,
# robots.txt and sitemap.xml. Set this before pointing a domain at the site.
NEXT_PUBLIC_SITE_URL=https://example.com

# Where quote requests are delivered. Defaults to the shop inbox in code.
QUOTE_TO_EMAIL=downsouthpressurewashing@yahoo.com

# --- Optional: Resend, for a properly branded email with photo attachments ---
# When RESEND_API_KEY is present it replaces FormSubmit as the delivery channel.
RESEND_API_KEY=
# Must be a verified sender in your Resend account.
QUOTE_FROM_EMAIL="Down South Website <quotes@yourdomain.com>"

# --- Optional: SMS notification for every new lead ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
QUOTE_SMS_TO=+19102738654